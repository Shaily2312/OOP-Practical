import java.io.*;

public class Main {
    public static void main(String[] args) {
        FileWriter fw = null;
        BufferedReader br = null;

        try {
            fw = new FileWriter("students.txt");
            fw.write("101 Alice 85\n");
            fw.write("102 Bob 78\n");
            fw.write("103 Charlie 92\n");
        } catch (IOException e) {
            System.out.println("Error writing file");
        } finally {
            try {
                if (fw != null) fw.close();
            } catch (IOException e) {
            }
        }

        try {
            br = new BufferedReader(new FileReader("students.txt"));
            String line;
            while ((line = br.readLine()) != null) {
                System.out.println(line);
            }
        } catch (IOException e) {
            System.out.println("Error reading file");
        } finally {
            try {
                if (br != null) br.close();
            } catch (IOException e) {
            }
        }
    }
}
